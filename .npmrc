# Block lifecycle scripts (preinstall/postinstall)
ignore-scripts=true

# Fail install when the running node does not satisfy engines in package.json
engine-strict=true

# Refuse versions younger than 7 days when 'npm install' resolves new deps (npm >= 11.10, no effect on 'npm ci').
# CI relies on the matching 7-day dependabot cooldown; keep the two in sync.
min-release-age=7

# Write exact versions (1.2.3, not ^1.2.3) when adding deps
save-exact=true

# Skip the audit network call on every install
audit=false

# Suppress funding banners
fund=false
