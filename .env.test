# Loaded by both vitest projects, since vitest runs vite in test mode.
#
# The MSW handlers are anchored to this host. Without it API_URL is an empty string, every request the app makes is
# relative, and the handler patterns would have to start with a wildcard that matches any path before them. Such a
# pattern also matches paths it was never meant to, so /search/customer/tickets would be answered by the handler for
# /customer/:identifier.
VITE_API_HOST=my.nva.api.test

# The app renders MaintenanceModeApp in place of itself whenever this holds a message, so a machine that has one set
# would run every test against the maintenance page instead of the app.
VITE_MAINTENANCE_MESSAGE_NB=

# Keeps the tests off an analytics server. useMatomoTracking only starts Matomo for a valid url, so an empty one is
# enough to leave it alone.
VITE_MATOMO_CONTAINER_URL=

# The app has a mock mode with canned data of its own. On a machine that has it set to true, `App` takes that branch
# instead of asking who is signed in, so the test never gets the user it asked for. We need to make sure the value is
# false in test mode.
VITE_USE_MOCK=false
