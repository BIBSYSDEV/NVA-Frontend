{
  "name": "nva-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "pre-commit": "lint-staged && npm run unused-i18n-keys",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite",
    "start:mock": "set VITE_USE_MOCK=true&& npm start",
    "start:mock:win": "set VITE_USE_MOCK=true&& npm start",
    "start:mock:unix": "export VITE_USE_MOCK=true && npm start",
    "test": "cypress install && cypress run",
    "test:vitest": "vitest",
    "test:vitest:verbose": "vitest run --reporter=verbose",
    "test:cypress": "start-server-and-test start:mock:win http://localhost:3000 test",
    "test:cypress:ci": "start-server-and-test preview http://localhost:3000 test",
    "test:cypress:open": "cypress install && cypress open",
    "unused-i18n-keys": "i18n-unused display-unused"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "9.3.1",
    "@mui/utils": "9.3.0",
    "@mui/x-date-pickers": "9.11.0",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.101.4",
    "@uppy/aws-s3": "5.1.0",
    "@uppy/core": "5.2.0",
    "@uppy/dashboard": "5.1.1",
    "@uppy/locales": "5.1.1",
    "@uppy/react": "5.2.0",
    "aws-amplify": "6.20.0",
    "axios": "1.19.0",
    "date-fns": "4.4.0",
    "deepmerge": "4.3.1",
    "formik": "2.4.9",
    "i18n-iso-countries": "7.14.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "isbn3": "2.0.10",
    "nva-language": "1.0.23",
    "pretty-bytes": "7.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-i18next": "17.0.11",
    "react-imask": "7.6.1",
    "react-redux": "9.3.0",
    "react-router": "8.3.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "axios-mock-adapter": "2.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "15.21.0",
    "cypress-axe": "1.7.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "i18n-unused": "0.20.0",
    "lint-staged": "17.3.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "start-server-and-test": "3.0.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.2.2",
    "vite-plugin-checker": "0.14.5",
    "vitest": "4.1.11"
  }
}
